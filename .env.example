# Copy this file to .env and fill in your real values before running locally.
# DO NOT commit .env; keep it local and secret.

MYSQL_DATABASE=exammasterpro
MYSQL_USER=examuser
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/exammasterpro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=examuser
SPRING_DATASOURCE_PASSWORD=change_me

# Docker Hub secrets for GitHub Actions
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_access_token
